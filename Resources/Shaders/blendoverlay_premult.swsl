light_mode unshaded;
blend_mode premultiplied;

// Overlay/Default blending for PREMULTIPLIED sources: plane masters,
// render-source relays and keep-together groups draw render-target textures,
// whose content already carries its alpha (drawing a straight source into a
// transparent target with the default SrcAlpha blend leaves Cs*a behind).
// Compositing that with a SrcAlpha factor would apply alpha a second time and
// darken every translucent RT hop, so this variant blends (One, 1-SrcAlpha)
// and applies a group's own alpha as a uniform scale of all four channels,
// which keeps the content premultiplied.

uniform lowp mat4 colorMatrix;
uniform lowp vec4 offsetVector; // The final row of the 4x5 matrix it kinda is
uniform lowp float premultAlpha; // The group's own alpha (plane master / KT)

void fragment() {
    // The world pipeline stores raw sRGB bytes: no conversion on sample or write.
    highp vec4 oldColor = zTexture(UV);
    COLOR[0] =  oldColor[0] * colorMatrix[0][0] +
                oldColor[1] * colorMatrix[0][1] +
                oldColor[2] * colorMatrix[0][2] +
                oldColor[3] * colorMatrix[0][3];

    COLOR[1] =  oldColor[0] * colorMatrix[1][0] +
                oldColor[1] * colorMatrix[1][1] +
                oldColor[2] * colorMatrix[1][2] +
                oldColor[3] * colorMatrix[1][3];

    COLOR[2] =  oldColor[0] * colorMatrix[2][0] +
                oldColor[1] * colorMatrix[2][1] +
                oldColor[2] * colorMatrix[2][2] +
                oldColor[3] * colorMatrix[2][3];

    COLOR[3] =  oldColor[0] * colorMatrix[3][0] +
                oldColor[1] * colorMatrix[3][1] +
                oldColor[2] * colorMatrix[3][2] +
                oldColor[3] * colorMatrix[3][3];
    COLOR = COLOR + offsetVector;
    COLOR *= premultAlpha;
}

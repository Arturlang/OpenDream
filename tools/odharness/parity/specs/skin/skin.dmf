macro "macro"
	elem "mac_f5"
		name = "F5"
		command = "skinxecho \"f5\""
	elem "mac_ctrl"
		name = "CTRL+E"
		command = "skinxecho \"ctrl\""
	elem
		name = "F6"
		command = "skinxecho \"f6\""

macro "macro2"
	elem "mac2_f7"
		name = "F7"
		command = "skinxecho \"f7\""

menu "menu"
	elem "m_file"
		name = "&File"
		command = ""
	elem "m_chk"
		name = "Check me"
		command = "skinxecho \"chk\""
		category = "&File"
		can-check = true
		is-checked = false
	elem "m_r1"
		name = "Radio one"
		command = ""
		category = "&File"
		can-check = true
		group = "mg"
		is-checked = true
	elem "m_r2"
		name = "Radio two"
		command = ""
		category = "&File"
		can-check = true
		group = "mg"
		is-checked = false
	elem "m_dis"
		name = "Disabled"
		command = ""
		category = "&File"
		is-disabled = true
	elem "m_cmd"
		name = "Command"
		command = "skinxecho \"menu\""
		category = "&File"

menu "menu2"
	elem "m2_top"
		name = "&Other"
		command = ""
	elem "m2_item"
		name = "Item"
		command = ""
		category = "&Other"

